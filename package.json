{
	"name": "lapikit.dev",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "bun run sync-docs && ./node_modules/.bin/vite dev",
		"build": "bun run sync-docs && ./node_modules/.bin/vite build",
		"build-srv": "bun run sync-docs && bun run sync-changelog && bun run sync-robots && ./node_modules/.bin/vite build",
		"preview": "./node_modules/.bin/vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"sync-docs": "node --experimental-strip-types scripts/sync-docs/index.ts",
		"sync-changelog": "node --experimental-strip-types scripts/sync-changelog/index.ts",
		"sync-robots": "node --experimental-strip-types scripts/sync-robots/index.ts",
		"check": "bun run sync-docs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"debug-path": "echo $PATH"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^9.39.4",
		"@lapikit/repl": "^0.0.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "^2.68.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26.0.1",
		"eslint": "^9.39.4",
		"eslint-config-lapikit": "^0.0.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"lapikit": "^0.0.0",
		"mdsvex": "^0.12.7",
		"prettier": "^3.9.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"tailwindcss": "^4.3.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.62.0",
		"vite": "^7.3.6",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/outfit": "^5.2.8",
		"lucide-svelte": "^1.0.1"
	}
}
